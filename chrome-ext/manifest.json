{
  "manifest_version": 3,
  "name": "Bee Mini – Bảng giá chứng khoán nổi & lọc cổ phiếu",
  "short_name": "Bee Mini",
  "version": "0.4.0",
  "description": "Bảng giá chứng khoán VN luôn nổi trên mọi cửa sổ. Lọc cổ phiếu bằng AI hoặc theo RSI, MACD, trendline; đọc mã mới bằng giọng Việt.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "tts", "storage", "unlimitedStorage"],
  "host_permissions": ["https://www.fireant.vn/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "sw.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Mở bảng Bee Mini",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
